<?xml version="1.0" encoding="utf-8"?>
<!-- Cannuran Pulse widget, v2 "modern" design. RemoteViews-safe views only (no plain <View>).
     One layout serves three density tiers; WidgetRenderer toggles sections per tier. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_midnight" android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/mark" android:layout_width="22dp" android:layout_height="22dp"
            android:background="@drawable/mark_bg_gold" android:padding="4dp" android:src="@drawable/ic_mark"
            android:tint="@color/pulse_gold" android:importantForAccessibility="no" />
        <TextView android:id="@+id/brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_brand" android:textColor="@color/pulse_gold" android:textSize="11.5sp" android:layout_marginStart="8dp" android:letterSpacing="0.16" android:textStyle="bold" />
        <TextView android:id="@+id/session" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10.5sp" android:layout_marginStart="8dp" android:background="@drawable/pill_surface" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/risk_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/risk_elev_fg" android:textSize="10.5sp" android:layout_marginStart="6dp" android:background="@drawable/pill_risk_elev" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:visibility="gone" />
        <TextView android:id="@+id/cch_head" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CCH" android:textColor="@color/pulse_gold" android:textSize="9.5sp" android:layout_marginStart="6dp" android:background="@drawable/badge_outline_gold" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:letterSpacing="0.08" android:textStyle="bold" android:visibility="gone" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:id="@+id/refresh" android:layout_width="30dp" android:layout_height="30dp"
            android:background="@drawable/circle_surface" android:contentDescription="@string/action_refresh"
            android:padding="7dp" android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <TextView android:id="@+id/bias" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_bias" android:textColor="@color/text_primary" android:textSize="16sp" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:maxLines="3" android:ellipsize="end" android:lineSpacingExtra="2dp" />

    <LinearLayout android:id="@+id/meter_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="92dp" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"
                 android:background="@drawable/seg_off" /><TextView android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:background="@drawable/seg_off" /><TextView android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:background="@drawable/seg_off" />
        </LinearLayout>
        <TextView android:id="@+id/risk_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Risk —" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/cch_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/cch_armed" android:textColor="@color/pulse_gold" android:textSize="10sp" android:background="@drawable/badge_outline_gold" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:letterSpacing="0.08" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:id="@+id/event_card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/event_bg_gold" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="13dp" android:paddingTop="10dp" android:paddingEnd="13dp"
        android:paddingBottom="10dp" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/event_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEXT RELEASE" android:textColor="@color/pulse_gold" android:textSize="9.5sp" android:letterSpacing="0.14" android:textStyle="bold" />
            <TextView android:id="@+id/event_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/event_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginTop="1dp" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:gravity="end" android:orientation="vertical">
            <Chronometer android:id="@+id/event_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" android:textColor="@color/pulse_gold" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/event_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/pulse_gold" android:textSize="18sp" android:fontFeatureSettings="tnum" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/event_caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="to print" android:textColor="@color/text_muted" android:textSize="9.5sp" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/quotes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:id="@+id/q1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" 
            android:background="@drawable/tile_bg" android:orientation="vertical"
            android:paddingStart="9dp" android:paddingTop="7dp" android:paddingEnd="9dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/q1_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="9.5sp" android:letterSpacing="0.08" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/q1_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <TextView android:id="@+id/q1_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10.5sp" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <ImageView android:id="@+id/q1_spark" android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginTop="2dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/q2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/tile_bg" android:orientation="vertical"
            android:paddingStart="9dp" android:paddingTop="7dp" android:paddingEnd="9dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/q2_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="9.5sp" android:letterSpacing="0.08" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/q2_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <TextView android:id="@+id/q2_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10.5sp" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <ImageView android:id="@+id/q2_spark" android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginTop="2dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/q3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/tile_bg" android:orientation="vertical"
            android:paddingStart="9dp" android:paddingTop="7dp" android:paddingEnd="9dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/q3_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="9.5sp" android:letterSpacing="0.08" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/q3_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <TextView android:id="@+id/q3_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10.5sp" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <ImageView android:id="@+id/q3_spark" android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginTop="2dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/q4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/tile_bg" android:orientation="vertical"
            android:paddingStart="9dp" android:paddingTop="7dp" android:paddingEnd="9dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/q4_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="9.5sp" android:letterSpacing="0.08" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/q4_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <TextView android:id="@+id/q4_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10.5sp" android:fontFeatureSettings="tnum" android:singleLine="true" />
            <ImageView android:id="@+id/q4_spark" android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginTop="2dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/sec_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/sec_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="HEADLINES" android:textColor="@color/text_muted" android:textSize="9.5sp" android:letterSpacing="0.14" android:textStyle="bold" />
        <TextView android:id="@+id/sec_meta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:layout_weight="1" android:textSize="10sp" android:gravity="end" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:id="@+id/h1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="11dp" android:paddingBottom="9dp"
        android:visibility="visible">
        <TextView android:id="@+id/h1_bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/bar_low" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/h1_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Waiting for the first brief…" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h1_dir" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10sp" android:background="@drawable/pill_mixed" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/h1_meta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Tap ⟳ to refresh" android:textColor="@color/text_muted" android:textSize="10.5sp" android:layout_weight="1" android:layout_marginStart="6dp" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/h1_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEW" android:textColor="@color/on_accent" android:textSize="9sp" android:layout_marginStart="6dp" android:background="@drawable/pill_new_gold" android:paddingStart="6dp" android:paddingEnd="6dp" android:textStyle="bold" android:letterSpacing="0.06" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/h2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="11dp" android:paddingBottom="9dp"
        android:visibility="gone">
        <TextView android:id="@+id/h2_bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/bar_low" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/h2_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h2_dir" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10sp" android:background="@drawable/pill_mixed" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/h2_meta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="10.5sp" android:layout_weight="1" android:layout_marginStart="6dp" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/h2_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEW" android:textColor="@color/on_accent" android:textSize="9sp" android:layout_marginStart="6dp" android:background="@drawable/pill_new_gold" android:paddingStart="6dp" android:paddingEnd="6dp" android:textStyle="bold" android:letterSpacing="0.06" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/h3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="11dp" android:paddingBottom="9dp"
        android:visibility="gone">
        <TextView android:id="@+id/h3_bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/bar_low" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/h3_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h3_dir" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10sp" android:background="@drawable/pill_mixed" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/h3_meta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="10.5sp" android:layout_weight="1" android:layout_marginStart="6dp" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/h3_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEW" android:textColor="@color/on_accent" android:textSize="9sp" android:layout_marginStart="6dp" android:background="@drawable/pill_new_gold" android:paddingStart="6dp" android:paddingEnd="6dp" android:textStyle="bold" android:letterSpacing="0.06" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/h4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="11dp" android:paddingBottom="9dp"
        android:visibility="gone">
        <TextView android:id="@+id/h4_bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/bar_low" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/h4_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h4_dir" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10sp" android:background="@drawable/pill_mixed" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/h4_meta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="10.5sp" android:layout_weight="1" android:layout_marginStart="6dp" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/h4_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEW" android:textColor="@color/on_accent" android:textSize="9sp" android:layout_marginStart="6dp" android:background="@drawable/pill_new_gold" android:paddingStart="6dp" android:paddingEnd="6dp" android:textStyle="bold" android:letterSpacing="0.06" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/h5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="11dp" android:paddingBottom="9dp"
        android:visibility="gone">
        <TextView android:id="@+id/h5_bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/bar_low" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/h5_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h5_dir" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="10sp" android:background="@drawable/pill_mixed" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/h5_meta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="10.5sp" android:layout_weight="1" android:layout_marginStart="6dp" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/h5_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEW" android:textColor="@color/on_accent" android:textSize="9sp" android:layout_marginStart="6dp" android:background="@drawable/pill_new_gold" android:paddingStart="6dp" android:paddingEnd="6dp" android:textStyle="bold" android:letterSpacing="0.06" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/watch" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />

    <LinearLayout android:id="@+id/footer_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/footer_left" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_footer" android:textColor="@color/text_muted" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/footer_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_muted" android:textSize="10sp" android:layout_marginStart="8dp" android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
